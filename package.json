{
  "name": "froned-dashbord",
  "version": "1.0.0",
  "private": true,
  "description": "A local dashboard for the job-hunt workspace, using the existing Python API and real data.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs --dev",
    "serve": "node scripts/start.mjs",
    "test": "playwright test",
    "test:auth-unit": "node --test tests/account-request-scope.test.mjs tests/firebase-auth.test.mjs tests/access-policy.test.mjs",
    "test:accounts": "playwright test --config playwright.accounts.config.js",
    "audit": "node scripts/audit.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "doctor": "react-doctor app/js/route-shell.js --no-score --no-supply-chain --yes --no-parallel"
  },
  "engines": {
    "node": ">=22.19"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "playwright-lighthouse": "^4.0.0",
    "react-doctor": "^0.9.18",
    "react-grab": "^0.2.0",
    "react-scan": "^0.5.7"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  }
}
