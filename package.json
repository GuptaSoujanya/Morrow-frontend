{
  "name": "froned-dashbord",
  "version": "1.0.0",
  "private": true,
  "description": "A local dashboard for the job-hunt workspace, using the existing Python API and real data.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs --dev",
    "serve": "node scripts/start.mjs",
    "test": "playwright test",
    "test:activity-unit": "node --test tests/run-stream.test.mjs tests/activity-format.test.mjs",
    "test:auth-unit": "node --test tests/account-request-scope.test.mjs tests/firebase-auth.test.mjs tests/access-policy.test.mjs tests/router.test.mjs",
    "test:beta": "playwright test --config playwright.beta.config.js",
    "test:learning": "playwright test --config playwright.learning.config.js",
    "test:feedback": "playwright test --config playwright.feedback.config.js",
    "test:flows": "playwright test --config playwright.flows.config.js",
    "test:onboarding": "playwright test --config playwright.onboarding.config.js",
    "test:accounts": "playwright test --config playwright.accounts.config.js",
    "audit": "node scripts/audit.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "doctor": "react-doctor app/js/route-shell.js --no-score --no-supply-chain --yes --no-parallel"
  },
  "engines": {
    "node": ">=22.19"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "playwright-lighthouse": "^4.0.0",
    "react-doctor": "^0.9.18",
    "react-grab": "^0.2.0",
    "react-scan": "^0.5.7"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@tanstack/react-query": "^5.104.5",
    "codemirror": "^6.0.2",
    "firebase": "^13.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  }
}
