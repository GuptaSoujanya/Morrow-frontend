# Free beta is the default: all local tools, no Morrow sign-in or payments.
MORROW_MODE=beta
# Used only with MORROW_MODE=accounts (or npm start -- --mode accounts).
MORROW_API_URL=http://127.0.0.1:8200
# Set this to the administrator who owns the existing local bot workspace.
MORROW_WORKSPACE_OWNER_EMAIL=admin@example.com
